# Record the real view functions in a CPU-only harness; no graphics context.
function(prisme_view_test_sources output)
    file(READ "${CMAKE_SOURCE_DIR}/src/view.c" _source)
    file(WRITE "${output}" "/* Actual view.c functions; generated for tests without a display. */\n")
    foreach(_part helpers topbar sidebar diagnostics console status completions shell browser settings xml context)
        if(_part STREQUAL "helpers")
            set(_begin "static void text(App *a, const char *s, float x, float y, float size, Tone t) {")
            set(_end "void app_field_draw(App *a,")
        elseif(_part STREQUAL "topbar")
            set(_begin "static void topbar(App *a) {")
            set(_end "static bool folder_expanded(App *a,")
        elseif(_part STREQUAL "sidebar")
            set(_begin "static bool folder_expanded(App *a, const char *path) {")
            set(_end "static void findbar(App *a) {")
        elseif(_part STREQUAL "diagnostics")
            set(_begin "static Tone diagnostic_tone(const Diagnostic *d) {")
            set(_end "static void editor(App *a, float dt) {")
        elseif(_part STREQUAL "console")
            set(_begin "static void console(App *a) {")
            set(_end "static void status(App *a) {")
        elseif(_part STREQUAL "status")
            set(_begin "static void status(App *a) {")
            set(_end "static void completions(App *a) {")
        elseif(_part STREQUAL "completions")
            set(_begin "static void completions(App *a) {")
            set(_end "static Rectangle shell(App *a,")
        elseif(_part STREQUAL "shell")
            set(_begin "static Rectangle shell(App *a,")
            set(_end "static void palette(App *a) {")
        elseif(_part STREQUAL "browser")
            set(_begin "static void browser(App *a) {")
            set(_end "static void toggle(App *a,")
        elseif(_part STREQUAL "settings")
            set(_begin "static void toggle(App *a,")
            set(_end "static void help(App *a) {")
        elseif(_part STREQUAL "xml")
            set(_begin "static void xml_dialog(App *a) {")
            set(_end "static void context_menu(App *a) {")
        else()
            set(_begin "static void context_menu(App *a) {")
            set(_end "static void filesystem_dialog(App *a) {")
        endif()
        string(FIND "${_source}" "${_begin}" _first)
        string(FIND "${_source}" "${_end}" _last)
        if(_first LESS 0 OR _last LESS_EQUAL _first)
            message(FATAL_ERROR "View test extraction failed: ${_part}")
        endif()
        math(EXPR _length "${_last} - ${_first}")
        string(SUBSTRING "${_source}" ${_first} ${_length} _function)
        file(APPEND "${output}" "${_function}\n")
    endforeach()
endfunction()
