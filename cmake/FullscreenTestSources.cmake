# Compile the EXACT patched backend functions with fake GLFW/rlgl calls. This
# exercises the upstream fullscreen/resize path, not just Prisme's rectangles.
# The tests never initialize GLFW, OpenGL, a window or a display server.
function(prisme_fullscreen_test_sources output glfw_source core_source)
    file(WRITE "${output}" "/* Generated from the pinned raylib sources, after local patches. */\n")
    foreach(_part IN ITEMS toggle resize screen_width screen_height render_width render_height viewport)
        if(_part STREQUAL "toggle")
            set(_file "${glfw_source}")
            set(_begin "void ToggleFullscreen(void)\n{")
            set(_end "// Toggle borderless windowed mode")
        elseif(_part STREQUAL "resize")
            set(_file "${glfw_source}")
            set(_begin "static void WindowSizeCallback(GLFWwindow *window, int width, int height)\n{")
            set(_end "static void WindowPosCallback(GLFWwindow* window, int x, int y)\n{")
        elseif(_part STREQUAL "screen_width")
            set(_file "${core_source}")
            set(_begin "int GetScreenWidth(void)\n{")
            set(_end "// Get current screen height\n")
        elseif(_part STREQUAL "screen_height")
            set(_file "${core_source}")
            set(_begin "int GetScreenHeight(void)\n{")
            set(_end "// Get current render width which")
        elseif(_part STREQUAL "render_width")
            set(_file "${core_source}")
            set(_begin "int GetRenderWidth(void)\n{")
            set(_end "// Get current screen height which")
        elseif(_part STREQUAL "render_height")
            set(_file "${core_source}")
            set(_begin "int GetRenderHeight(void)\n{")
            set(_end "// Enable waiting for events on EndDrawing()")
        else()
            set(_file "${core_source}")
            set(_begin "void SetupViewport(int width, int height)\n{")
            set(_end "// Compute framebuffer size relative to screen size and display size")
        endif()
        file(READ "${_file}" _source)
        string(FIND "${_source}" "${_begin}" _first)
        string(FIND "${_source}" "${_end}" _last)
        if(_first LESS 0 OR _last LESS_EQUAL _first)
            message(FATAL_ERROR "Cannot extract actual raylib fullscreen test function: ${_part}")
        endif()
        math(EXPR _length "${_last} - ${_first}")
        string(SUBSTRING "${_source}" ${_first} ${_length} _function)
        file(APPEND "${output}" "${_function}\n")
    endforeach()
endfunction()
