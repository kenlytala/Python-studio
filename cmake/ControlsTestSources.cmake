# Test the production controller functions without creating a native window.
function(prisme_controls_test_sources output)
    file(READ "${CMAKE_SOURCE_DIR}/src/app.c" _source)
    file(WRITE "${output}" "/* Actual Prisme controller functions; generated for CPU-only tests. */\n")
    foreach(_part minimize path_join python absolute_path parent close key_helpers fields path_guard enabled analysis imports quit deletion edges cursor gestures)
        if(_part STREQUAL "minimize")
            set(_begin "void app_minimize_window(App *a) {")
            set(_end "static void action(App *a, Action id, int arg) {")
        elseif(_part STREQUAL "path_join")
            set(_begin "static bool path_join(char *out, size_t capacity, const char *base, const char *leaf) {")
            set(_end "static bool suffix(const char *s, const char *end) {")
        elseif(_part STREQUAL "parent")
            set(_begin "static const char *native_parent(const char *path) {")
            set(_end "Buffer *app_buffer(App *a) {")
        elseif(_part STREQUAL "close")
            set(_begin "static void close_modal(App *a) {")
            set(_end "static void invalidate(App *a) {")
        elseif(_part STREQUAL "key_helpers")
            set(_begin "static bool pressed(App *a, int key) {")
            set(_end "bool app_history_keys(App *a, Buffer *b, bool ctrl, bool shift) {")
        elseif(_part STREQUAL "fields")
            set(_begin "bool app_history_keys(App *a, Buffer *b, bool ctrl, bool shift) {")
            set(_end "static size_t mouse_position(App *a, Vector2 m) {")
        elseif(_part STREQUAL "path_guard")
            set(_begin "bool app_path_usable(App *a, const char *path) {")
            set(_end "void app_ssh_reset_analysis(App *a) {")
        elseif(_part STREQUAL "imports")
            set(_begin "static void load_project_imports(App *a) {")
            set(_end "static void refresh_browser(App *a) {")
        elseif(_part STREQUAL "python")
            set(_begin "static bool suffix(const char *s, const char *end) {")
            set(_end "static bool contains_ci(const char *text, const char *q) {")
        elseif(_part STREQUAL "analysis")
            set(_begin "static bool analysis_filename(App *a, int index, char *out) {")
            set(_end "static bool open_file(App *a, const char *path, bool quiet) {")
        elseif(_part STREQUAL "absolute_path")
            set(_begin "static void absolute_path(char *out, size_t cap, const char *path, const char *base) {")
            set(_end "static const char *native_parent(const char *path) {")
        elseif(_part STREQUAL "enabled")
            set(_begin "Action app_context_action(int index) {")
            set(_end "static void context_expand(App *a, const char *path) {")
        elseif(_part STREQUAL "quit")
            set(_begin "static void request_quit(App *a) {")
            set(_end "static void finish_pending(App *a) {")
        elseif(_part STREQUAL "deletion")
            set(_begin "static void context_delete(App *a) {")
            set(_end "static void context_paste(App *a) {")
        elseif(_part STREQUAL "edges")
            set(_begin "static int window_edges(App *a, Vector2 m) {")
            set(_end "static int window_cursor(int edge) {")
        elseif(_part STREQUAL "cursor")
            set(_begin "static int window_cursor(int edge) {")
            set(_end "static bool window_gestures(App *a, Vector2 m) {")
        else()
            set(_begin "static bool window_gestures(App *a, Vector2 m) {")
            set(_end "static bool mouse_update(App *a, bool ctrl, bool shift) {")
        endif()
        string(FIND "${_source}" "${_begin}" _first)
        string(FIND "${_source}" "${_end}" _last)
        if(_first LESS 0 OR _last LESS_EQUAL _first)
            message(FATAL_ERROR "Controller test extraction failed: ${_part}")
        endif()
        math(EXPR _length "${_last} - ${_first}")
        string(SUBSTRING "${_source}" ${_first} ${_length} _function)
        file(APPEND "${output}" "${_function}\n")
    endforeach()
endfunction()

# Full production frame routing + mouse and modal dispatch, not a copied F11 test.
# Unrelated services are stubbed by test_controls; these bodies stay byte-for-byte.
function(prisme_frame_test_sources output)
    file(READ "${CMAKE_SOURCE_DIR}/src/app.c" _source)
    file(WRITE "${output}" "/* Actual production input/frame functions; CPU-only regression. */\n")
    foreach(_part mouse modal editor frame)
        if(_part STREQUAL "mouse")
            set(_begin "static bool mouse_update(App *a, bool ctrl, bool shift) {")
            set(_end "static void emit(App *a) {")
        elseif(_part STREQUAL "modal")
            set(_begin "static void modal_keys(App *a, const unsigned *chars, int count, bool ctrl, bool shift) {")
            set(_end "static void editor_keys(App *a, const unsigned *chars, int count, bool ctrl, bool shift) {")
        elseif(_part STREQUAL "editor")
            set(_begin "static void editor_keys(App *a, const unsigned *chars, int count, bool ctrl, bool shift) {")
            set(_end "static bool window_shortcuts(App *a)")
        else()
            set(_begin "static bool window_shortcuts(App *a)")
            set(_end "static void load_settings(App *a) {")
        endif()
        string(FIND "${_source}" "${_begin}" _first)
        string(FIND "${_source}" "${_end}" _last)
        if(_first LESS 0 OR _last LESS_EQUAL _first)
            message(FATAL_ERROR "Full-frame test extraction failed: ${_part}")
        endif()
        math(EXPR _length "${_last} - ${_first}")
        string(SUBSTRING "${_source}" ${_first} ${_length} _function)
        if(_part STREQUAL "editor")
            file(APPEND "${output}" "#undef editor_keys\n#define editor_keys frame_editor_real\n${_function}\n#undef editor_keys\n#define editor_keys frame_editor_keys\n")
        else()
            file(APPEND "${output}" "${_function}\n")
        endif()
    endforeach()
endfunction()
